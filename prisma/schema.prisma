generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  username           String?  @unique
  usernameNormalized String?  @unique @map("username_normalized")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  badge            Badge?
  externalAccounts ExternalAccount[]

  @@map("users")
}

// ─── Badges ───────────────────────────────────────────────────────────────────

model Badge {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  dualObjectId   String @map("dual_object_id")
  dualTemplateId String @map("dual_template_id")

  // Signal Score (0–1000) and derived tier
  signalScore Int  @default(0) @map("signal_score")
  cachedTier  Tier @default(INITIATE) @map("cached_tier")

  // Achievement track levels (0 = locked / not connected, 1–5 = level reached)
  xSignalLevel    Int @default(0) @map("x_signal_level")
  telegramLevel   Int @default(0) @map("telegram_level")
  discordLevel    Int @default(0) @map("discord_level")
  governanceLevel Int @default(0) @map("governance_level")

  // Progress counters (cached from evidence tables)
  xSignalPublicViews Int @default(0) @map("x_signal_public_views")
  xQualifyingPosts   Int @default(0) @map("x_qualifying_posts")
  telegramActiveDays Int @default(0) @map("telegram_active_days")
  discordActiveDays  Int @default(0) @map("discord_active_days")
  governanceVotes    Int @default(0) @map("governance_votes")

  // Special status
  isOG Boolean @default(false) @map("is_og")

  // Display / identity fields
  walletAddress  String @default("") @map("wallet_address")
  memberSince    String @default("") @map("member_since")
  discordHandle  String @default("") @map("discord_handle")
  telegramHandle String @default("") @map("telegram_handle")
  xHandle        String @default("") @map("x_handle")

  lastIntegrityHash String @default("") @map("last_integrity_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  badgeUpdates             BadgeUpdate[]
  xPosts                   XPost[]
  telegramDays             TelegramActiveDay[]
  discordDays              DiscordActiveDay[]
  governanceParticipations GovernanceParticipation[]

  @@map("badges")
}

// ─── Evidence Tables ──────────────────────────────────────────────────────────

model XPost {
  id      String @id @default(cuid())
  badgeId String @map("badge_id")
  badge   Badge  @relation(fields: [badgeId], references: [id])

  // Immutable X identifiers
  postId        String @map("post_id")
  authorXUserId String @default("") @map("author_x_user_id")
  authorHandle  String @default("") @map("author_handle")

  // Classification (determined on first fetch, stored as minimal metadata)
  qualifies      Boolean @default(false)
  matchedKeyword String? @map("matched_keyword")

  // View counts — current = most recently fetched; first = when first observed
  publicViews         BigInt @default(0) @map("public_views")
  firstObservedViews  BigInt @default(0) @map("first_observed_views")

  // Timestamps
  postedAt      DateTime  @map("posted_at")
  firstSeenAt   DateTime? @map("first_seen_at")
  lastCheckedAt DateTime? @map("last_checked_at")
  nextCheckAt   DateTime? @map("next_check_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at")

  // Refresh metadata
  checkCount Int           @default(0) @map("check_count")
  status     XPostStatus   @default(ACTIVE)

  @@unique([badgeId, postId])
  @@index([nextCheckAt])
  @@index([badgeId, qualifies])
  @@map("x_posts")
}

model TelegramActiveDay {
  id        String   @id @default(cuid())
  badgeId   String   @map("badge_id")
  badge     Badge    @relation(fields: [badgeId], references: [id])
  day       DateTime @map("day") @db.Date

  // Import provenance — null for manually created records
  sourceImportId         String?         @map("source_import_id")
  sourceImport           TelegramImport? @relation(fields: [sourceImportId], references: [id])
  telegramProviderUserId String?         @map("telegram_provider_user_id")
  firstMessageId         String?         @map("first_message_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([badgeId, day])
  @@map("telegram_active_days")
}

model DiscordActiveDay {
  id        String   @id @default(cuid())
  badgeId   String   @map("badge_id")
  badge     Badge    @relation(fields: [badgeId], references: [id])
  day       DateTime @map("day") @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([badgeId, day])
  @@map("discord_active_days")
}

model GovernanceParticipation {
  id             String   @id @default(cuid())
  badgeId        String   @map("badge_id")
  badge          Badge    @relation(fields: [badgeId], references: [id])
  proposalId     String   @map("proposal_id")
  participatedAt DateTime @map("participated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([badgeId, proposalId])
  @@map("governance_participations")
}

// ─── External Accounts ────────────────────────────────────────────────────────

model ExternalAccount {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  source         Provider  @map("source")
  externalUserId String    @map("external_user_id")
  handle         String
  verifiedAt     DateTime? @map("verified_at")

  // X-specific: cursor for incremental timeline fetch (since_id)
  lastXPostId  String?   @map("last_x_post_id")
  // X-specific: when the X user ID was resolved from the handle
  xResolvedAt  DateTime? @map("x_resolved_at")

  events Event[]

  @@unique([source, externalUserId])
  @@map("external_accounts")
}

// ─── Events ───────────────────────────────────────────────────────────────────

model Event {
  id String @id @default(cuid())

  source        EventSource @map("source")
  sourceEventId String      @map("source_event_id")
  contentId     String      @default("") @map("content_id")

  externalAccountId String?          @map("external_account_id")
  externalAccount   ExternalAccount? @relation(fields: [externalAccountId], references: [id])

  type   String
  status EventStatus @default(PENDING)

  rejectionReason String? @map("rejection_reason")
  payload         Json    @default("{}")

  occurredAt  DateTime  @map("occurred_at")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([source, sourceEventId])
  @@map("events")
}

// ─── Badge Update Queue ───────────────────────────────────────────────────────

model BadgeUpdate {
  id      String @id @default(cuid())
  badgeId String @map("badge_id")
  badge   Badge  @relation(fields: [badgeId], references: [id])

  requestedState Json @map("requested_state")

  status       UpdateStatus @default(PENDING)
  attempts     Int          @default(0)
  dualActionId String?      @map("dual_action_id")
  errorMessage String?      @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("badge_updates")
}

// ─── X API Budget Ledger ─────────────────────────────────────────────────────

model XApiUsage {
  id            String   @id @default(cuid())
  // Billing cycle key — YYYY-MM-DD of cycle start (e.g. "2026-09-05")
  billingCycle  String   @map("billing_cycle")
  endpoint      String
  resourceCount Int      @default(0) @map("resource_count")
  // Stored as microdollars-as-float; label in UI as "Estimated"
  estimatedCost Float    @default(0) @map("estimated_cost")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([billingCycle])
  @@map("x_api_usage")
}

// ─── Telegram Import ─────────────────────────────────────────────────────────

model TelegramImport {
  id                String       @id @default(cuid())
  filename          String
  messageCount      Int          @default(0) @map("message_count")
  matchedUsers      Int          @default(0) @map("matched_users")
  unmatchedUsers    Int          @default(0) @map("unmatched_users")
  activeDaysCreated Int          @default(0) @map("active_days_created")
  duplicatesIgnored Int          @default(0) @map("duplicates_ignored")
  importedWeekStart String?      @map("imported_week_start")
  importedWeekEnd   String?      @map("imported_week_end")
  status            ImportStatus @default(COMPLETED)
  error             String?
  isDryRun          Boolean      @default(false) @map("is_dry_run")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at")

  identities TelegramImportIdentity[]
  activeDays TelegramActiveDay[]

  @@map("telegram_imports")
}

model TelegramImportIdentity {
  id             String         @id @default(cuid())
  importId       String         @map("import_id")
  import         TelegramImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  telegramUserId String         @map("telegram_user_id")
  handle         String
  displayName    String         @map("display_name")
  messageCount   Int            @default(0) @map("message_count")
  uniqueDays     Int            @default(0) @map("unique_days")
  firstSeenDate  String         @map("first_seen_date")
  lastSeenDate   String         @map("last_seen_date")
  // JSON array of "YYYY-MM-DD" strings — stored for retroactive linking of unmatched users
  activeDates    Json           @default("[]") @map("active_dates")

  matchedUserId  String?        @map("matched_user_id")
  matchedBadgeId String?        @map("matched_badge_id")
  matchReason    String?        @map("match_reason")
  status         IdentityStatus @default(UNMATCHED)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([importId, telegramUserId])
  @@map("telegram_import_identities")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Tier {
  INITIATE
  EXPLORER
  BUILDER
  STAKEHOLDER
  GENESIS
  LEGEND
}

// Provider: identity sources for ExternalAccount (who can be connected)
enum Provider {
  TWITTER
  TELEGRAM
  DISCORD
  DUAL_FORUM
}

// EventSource: all possible event origins (broader than Provider)
enum EventSource {
  MOCK
  DUAL
  DISCORD
  TELEGRAM
  TWITTER
  LINKEDIN
  DUAL_FORUM
}

enum EventStatus {
  PENDING
  PROCESSED
  REJECTED
  DUPLICATE
}

enum UpdateStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ImportStatus {
  COMPLETED
  FAILED
  DRY_RUN
}

enum IdentityStatus {
  MATCHED
  UNMATCHED
  AMBIGUOUS
  LINKED
}

enum XPostStatus {
  ACTIVE       // post exists and is being tracked
  UNAVAILABLE  // post returned 404/403 — preserve last verified views, flag for review
  DELETED      // confirmed deleted
  MANUAL       // manually added by admin (not discovered via API)
}
