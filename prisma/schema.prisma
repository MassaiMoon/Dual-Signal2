generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  badge            Badge?
  externalAccounts ExternalAccount[]

  @@map("users")
}

// ─── Badges ───────────────────────────────────────────────────────────────────

model Badge {
  id     String @id @default(cuid())
  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  dualObjectId   String @map("dual_object_id")
  dualTemplateId String @map("dual_template_id")

  // Signal Score (0–1000) and derived tier
  signalScore Int  @default(0) @map("signal_score")
  cachedTier  Tier @default(INITIATE) @map("cached_tier")

  // Achievement track levels (0 = locked, 1–5 = level reached)
  xSignalLevel    Int @default(0) @map("x_signal_level")
  telegramLevel   Int @default(0) @map("telegram_level")
  governanceLevel Int @default(0) @map("governance_level")
  holderLevel     Int @default(0) @map("holder_level")

  // Progress values (raw counters for each track)
  xSignalImpressions Int @default(0) @map("x_signal_impressions")
  telegramActiveDays Int @default(0) @map("telegram_active_days")
  governanceVotes    Int @default(0) @map("governance_votes")
  holderQualDays     Int @default(0) @map("holder_qual_days")

  // Special status
  isOG Boolean @default(false) @map("is_og")

  // Display fields
  walletAddress  String @default("") @map("wallet_address")
  memberSince    String @default("") @map("member_since")
  discordHandle  String @default("") @map("discord_handle")
  telegramHandle String @default("") @map("telegram_handle")

  lastIntegrityHash String @default("") @map("last_integrity_hash")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  badgeUpdates BadgeUpdate[]

  @@map("badges")
}

// ─── External Accounts ────────────────────────────────────────────────────────

model ExternalAccount {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  source         EventSource @map("source")
  externalUserId String      @map("external_user_id")
  handle         String
  verifiedAt     DateTime?   @map("verified_at")

  events Event[]

  @@unique([source, externalUserId])
  @@map("external_accounts")
}

// ─── Events ───────────────────────────────────────────────────────────────────

model Event {
  id String @id @default(cuid())

  source        EventSource @map("source")
  sourceEventId String      @map("source_event_id")
  contentId     String      @default("") @map("content_id")

  externalAccountId String?          @map("external_account_id")
  externalAccount   ExternalAccount? @relation(fields: [externalAccountId], references: [id])

  type   String
  status EventStatus @default(PENDING)

  rejectionReason String? @map("rejection_reason")
  payload         Json    @default("{}")

  occurredAt  DateTime  @map("occurred_at")
  processedAt DateTime? @map("processed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([source, sourceEventId])
  @@map("events")
}

// ─── Badge Update Queue ───────────────────────────────────────────────────────

model BadgeUpdate {
  id      String @id @default(cuid())
  badgeId String @map("badge_id")
  badge   Badge  @relation(fields: [badgeId], references: [id])

  requestedState Json @map("requested_state")

  status       UpdateStatus @default(PENDING)
  attempts     Int          @default(0)
  dualActionId String?      @map("dual_action_id")
  errorMessage String?      @map("error_message")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("badge_updates")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Tier {
  INITIATE
  EXPLORER
  BUILDER
  STAKEHOLDER
  GENESIS
  LEGEND
}

enum EventSource {
  MOCK
  DISCORD
  TELEGRAM
  TWITTER
  LINKEDIN
}

enum EventStatus {
  PENDING
  PROCESSED
  REJECTED
  DUPLICATE
}

enum UpdateStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}
