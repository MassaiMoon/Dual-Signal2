# PostgreSQL — Railway provides DATABASE_URL automatically when a DB is attached
DATABASE_URL="postgresql://user:password@localhost:5432/dual_signal"

# DUAL Platform
DUAL_API_BASE="https://api.dual.network"
DUAL_API_KEY="keeJoa-..."          # your read-only key (swap for write-enabled key)
DUAL_EMAIL="your@email.com"        # login credentials for JWT auth (write operations)
DUAL_PASSWORD="your-password"
DUAL_ORG_ID="6a9831bdc8ff2688f8c9d3e2"
DUAL_SIGNAL_TEMPLATE_ID=""         # io.dual.signal.community-badge.v1 template ID from DUAL console

# Webhook security
WEBHOOK_TEST_SECRET="change-me-in-production"  # secret for POST /api/webhooks/test (dev only)
DUAL_WEBHOOK_SECRET=""                          # HMAC-SHA256 secret from DUAL dashboard — set after running register-webhook
DUAL_WEBHOOK_SIGNATURE_HEADER="x-dual-signature" # adjust if DUAL uses a different header name
DUAL_WEBHOOK_DEBUG=""                           # set to "1" on first deploy to log raw headers/body

# Admin
ADMIN_TOKEN="change-me-in-production"          # bearer token for /api/admin/* and /api/cron/* routes

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
